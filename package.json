{
  "name": "cruds-impresion-api",
  "version": "1.0.0",
  "type": "module",
  "description": "CRUD API para sistema de impresiones con TypeScript, Express y MySQL",
  "main": "dist/app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node dist/app.js",
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "install:clean": "rm -rf node_modules package-lock.json && npm install --legacy-peer-deps",
    "railway:build": "./build-railway.sh",
    "railway:simple": "npm install --legacy-peer-deps --no-fund --no-audit && tsc",
    "test:build": "tsc --noEmit",
    "dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/app.js\"",
    "start:dev": "npm run dev"
  },
  "keywords": ["api", "crud", "typescript", "express", "mysql", "printing"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mikro-orm/cli": "5.8.10",
    "@mikro-orm/core": "5.8.10",
    "@mikro-orm/migrations": "5.8.10",
    "@mikro-orm/mysql": "5.8.10",
    "@mikro-orm/sql-highlighter": "1.0.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "0.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.5.0",
    "tsc-watch": "6.0.4",
    "typescript": "^5.1.6"
  }
}
